        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "requestId": {
                        "type": "string"
                      },
                      "appointmentId": {
                        "type": "string"
                      },
                      "action": {
                        "type": "string",
                        "enum": [
                          "status"
                        ]
                      }
                    },
                    "required": [
                      "requestId",
                      "appointmentId",
                      "action"
