    "/operations": {
      "post": {
        "summary": "Perform an appointment operation",
        "description": "Manager, agent or integration. Reuse requestId only with the same payload within the same organization.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "appointment": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "customer": {
                          "type": "string"
                        },
                        "slot": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "customer",
                        "slot"
                      ]
                    },
                    "caseId": {
                      "type": "string"
                    }
                  },
                  "required": [
