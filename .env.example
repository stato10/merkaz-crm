DATABASE_URL=postgres://crm:crm@localhost:5433/crm
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Webhook retry worker: call GET /api/cron/webhooks with "Authorization: Bearer $CRON_SECRET" every minute
CRON_SECRET=

# Logging: debug | info | warn | error
LOG_LEVEL=info

# Public demo: shows a one-click demo login on /login (seed it with `npm run db:seed`)
NEXT_PUBLIC_DEMO_MODE=0
# DEMO_PASSWORD=            # seed password override
# NEXT_PUBLIC_DEMO_PASSWORD=  # must match DEMO_PASSWORD if you set it

# AI agent (Claude). Without it the AI features show a "not configured" notice.
ANTHROPIC_API_KEY=
# Per-user and per-organization caps on model calls (the demo is public)
# AI_USER_LIMIT_PER_HOUR=30
# AI_ORG_LIMIT_PER_DAY=200

# Channels: key that encrypts provider credentials (32 bytes, base64).
# Optional: derived from BETTER_AUTH_SECRET when unset. Changing either makes stored credentials unreadable.
# CHANNEL_SECRET_KEY=
